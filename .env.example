# =====================================================================
# VELQUARATH CAFE & RESTAURANT - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Copy this file to `.env.production` or `.env` for production Vite builds:
#   cp .env.example .env.production
#
# IMPORTANT FOR CLOUDFLARE WORKERS (Static Assets Mode):
# Your Cloudflare Worker serves static assets from `./dist`. Cloudflare runtime
# environment variables and secrets do NOT exist in visitors' browsers.
#
# Vite bakes `VITE_SUPABASE_URL` and `VITE_SUPABASE_ANON_KEY` directly into the
# compiled JavaScript bundle at build time.
#
# Build & Deploy Steps:
#   1. Set your values below in `.env.production` (already in .gitignore)
#   2. Run: npm run build
#   3. Deploy static assets: npx wrangler deploy
# =====================================================================

# 1. Supabase Project URL (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL="https://your-project.supabase.co"

# 2. Supabase Anon / Publishable Key (Public Only)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
# Format: Starts with "sb_publishable_" or "eyJhbGciOi..."
# CRITICAL: NEVER use your service-role or secret key here!
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# 3. Optional Gemini API Key
# Automatically injected by AI Studio or set locally if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 4. Optional App URL
APP_URL="MY_APP_URL"
