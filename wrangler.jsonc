{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velquarath-restaurant",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  }
}
